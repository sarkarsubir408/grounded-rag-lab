# Live OpenAI requests remain disabled unless both this flag and the in-app
# per-request authorization checkbox are enabled.
RAG_ENABLE_LIVE_API=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30

# The embeddings model/revision match the stabilized baseline.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
RRF_CONSTANT=60
ABSTENTION_CALIBRATION_FILE=reports/public_release/abstention_calibration.json
